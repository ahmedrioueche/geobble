PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/geobble
CLIENT_ORIGINS=http://localhost:5173

ROOM_MAX_PLAYERS=8
ROOM_ID_LENGTH=8
SOCKET_EVENTS_PER_MINUTE=120
MAX_CHALLENGE_VALUE=500
ROOM_RECONNECT_GRACE_MS=60000
ROOM_EXPIRY_HOURS=24
